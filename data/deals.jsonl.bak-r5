{"id": "eurohpc-ai-factories", "name": "EuroHPC AI Factories", "category": "GPU Compute", "pricing": "free", "deal": "Free Supercomputer GPU Access for EU Startups", "code": "", "url": "https://www.eurohpc-ju.europa.eu/ai-factories_en", "affiliate_url": "", "tracking_id": "eurohpc-ju-ai-factories", "has_affiliate": false, "desc": "Free, customised support and compute access for European startups and SMEs through the EU network of 19 AI Factories and 13 Antennas. Each AI Factory operates its own access route to the supercomputer it is attached to, and the capacity is aimed at AI model work rather than general hosting. Publicly funded, so there is no invoice to manage.", "tags": "gpu,compute,europe,research,allocation,recommended", "why": "The largest publicly funded GPU access open to a European startup, and it runs on supercomputers rather than a cloud console", "expires": null, "rating": 8.6, "offer_type": "allocation", "value": {"headline": "Free Supercomputer GPU Access for EU Startups", "usd": null, "unit": null}, "eligibility": {"audience": ["startup", "researcher", "sme"], "geo_allow": ["EU"]}, "gates": {"card": null, "phone": null, "kyc": null, "oauth": null, "captcha": null, "ease_score": 40}, "verification": {"verified_at": "2026-11-24", "source_url": "https://www.eurohpc-ju.europa.eu/ai-factories_en", "verified_by": "editorial"}, "claim": {"url": "https://www.eurohpc-ju.europa.eu/ai-factories_en", "method": "form"}, "status": "active", "disclosure": "editorial"}
{"id": "google-tpu-research-cloud", "name": "Google TPU Research Cloud", "category": "GPU Compute", "pricing": "free", "deal": "1,000+ Free Cloud TPUs", "code": "", "url": "https://sites.research.google/trc/about/", "affiliate_url": "", "tracking_id": "google-tpu-research-cloud", "has_affiliate": false, "desc": "Free access to a cluster of more than 1,000 Cloud TPU devices for machine learning research, at no charge, with support for TensorFlow, PyTorch, JAX and Julia. There is no dollar cap. In exchange, participants are expected to share what they find — peer-reviewed publications, open source code, or blog posts — and to give Google feedback on the platform.", "tags": "tpu,gpu,compute,research,allocation,recommended", "why": "No dollar cap and no funding test — the largest research compute grant on the open web, and the results have to be published anyway", "expires": null, "rating": 8.8, "offer_type": "allocation", "value": {"headline": "1,000+ Free Cloud TPUs", "usd": null, "unit": null}, "eligibility": {"audience": ["researcher", "student", "startup"], "geo_allow": ["global"]}, "gates": {"card": null, "phone": null, "kyc": null, "oauth": null, "captcha": null, "ease_score": 45}, "verification": {"verified_at": "2026-11-24", "source_url": "https://sites.research.google/trc/about/", "verified_by": "editorial"}, "claim": {"url": "https://sites.research.google/trc/about/", "method": "form"}, "status": "active", "disclosure": "editorial"}
{"id": "amd-ai-developer-program", "name": "AMD AI Developer Program", "category": "GPU Compute", "pricing": "free", "deal": "Free Membership + Complimentary Compute Credits", "code": "", "url": "https://developer.amd.com/ai-developer-program/", "affiliate_url": "", "tracking_id": "amd-ai-developer-program", "has_affiliate": false, "desc": "Free membership for developers, students and startups, with complimentary compute credits from AMD Developer Cloud or Fireworks AI, or instant API access through Token Lab. Joining also includes a one-month complimentary DeepLearning.AI membership, a ten-level points scheme as you complete developer activities, and ROCm certification paths. No AMD hardware required.", "tags": "gpu,amd,compute,credits,membership,recommended", "why": "The only route to free AMD Instinct GPU credits anywhere, and joining takes minutes with no hardware and no card", "expires": null, "rating": 8.2, "offer_type": "membership", "value": {"headline": "Free Membership + Complimentary Compute Credits", "usd": null, "unit": null}, "eligibility": {"audience": ["anyone", "developer", "student", "startup"], "geo_allow": ["global"]}, "gates": {"card": null, "phone": null, "kyc": null, "oauth": null, "captcha": null, "ease_score": 30}, "verification": {"verified_at": "2026-11-24", "source_url": "https://developer.amd.com/ai-developer-program/", "verified_by": "editorial"}, "claim": {"url": "https://developer.amd.com/ai-developer-program/", "method": "link"}, "status": "active", "disclosure": "editorial"}
{"id": "runpod-startup-program", "name": "RunPod Startup Program", "category": "GPU Compute", "pricing": "free", "deal": "$1,000-$25,000 GPU Credits", "code": "", "url": "https://www.runpod.io/startup-program", "affiliate_url": "", "tracking_id": "runpod-startup-program", "has_affiliate": false, "desc": "Tiered GPU credits decided by how much the company has raised and whether it is VC-backed: Starter for teams under $1M raised gets $1,000, Venture for teams with a verified VC on the cap table gets $5,000, and Growth for teams past $5M raised gets $10,000 to $25,000 against a usage commitment. Credits expire one year after issue, one free offer per company, and existing RunPod customers are not eligible for the free Starter or Venture credits.", "tags": "gpu,compute,startup,credits,selective", "why": "The largest no-investor GPU credit with a self-serve application — and it decides fast", "expires": null, "rating": 8.4, "requiresProgram": "startup", "offer_type": "credits", "value": {"headline": "$1,000-$25,000 GPU Credits", "usd": 25000.0, "unit": "usd"}, "eligibility": {"audience": ["startup"], "referral_required": false, "geo_allow": ["global"], "new_customers_only": true}, "terms": {"expiry_days": 365, "activation_window_days": null, "stackable": false, "post_credit_billing": "Standard pay-as-you-go GPU rates resume once the credits are spent.", "renewable": false}, "gates": {"card": null, "phone": null, "kyc": null, "oauth": null, "captcha": null, "ease_score": 55}, "verification": {"verified_at": "2026-11-24", "source_url": "https://www.runpod.io/startup-program", "verified_by": "editorial"}, "claim": {"url": "https://www.runpod.io/startup-program", "method": "form"}, "status": "active", "disclosure": "editorial"}
{"id": "nebius-for-startups", "name": "Nebius for Startups", "category": "GPU Compute", "pricing": "free", "deal": "Credits, Reserved Capacity and Engineering Support", "code": "", "url": "https://nebius.com/startups", "affiliate_url": "", "tracking_id": "nebius-for-startups", "has_affiliate": false, "desc": "Startup credits and reserved cluster capacity for venture-backed AI-native startups, plus engineering support. Nebius also runs an AI Builder Program open to anyone with no funding requirement, and a Tavily partner track offering 100k free credits to companies backed by a VC or a top accelerator. Credit amounts are not published, so size is a conversation.", "tags": "gpu,compute,startup,credits,selective", "why": "Reserved cluster capacity rather than a balance — the scarce thing when you are mid-training run and the region is sold out", "expires": null, "rating": 8.3, "requiresProgram": "startup", "offer_type": "credits", "value": {"headline": "Credits, Reserved Capacity and Engineering Support", "usd": null, "unit": null}, "eligibility": {"audience": ["startup"], "geo_allow": ["global"]}, "gates": {"card": null, "phone": null, "kyc": null, "oauth": null, "captcha": null, "ease_score": 50}, "verification": {"verified_at": "2026-11-24", "source_url": "https://nebius.com/startups", "verified_by": "editorial"}, "claim": {"url": "https://nebius.com/startups", "method": "form"}, "status": "active", "disclosure": "editorial"}
{"id": "guepard-for-startups", "name": "Guepard for Startups", "category": "Database", "pricing": "free", "deal": "Up to $30,000 Postgres Branching Credits", "code": "", "url": "https://guepard.run/startups", "affiliate_url": "", "tracking_id": "guepard-for-startups", "has_affiliate": false, "desc": "Up to $30,000 in Guepard platform credits for Postgres environment branching, with twelve months to use them from activation, plus onboarding support. Built for venture-backed teams at Series A or earlier — typically under 20 employees and less than three years old. Review is rolling.", "tags": "database,postgres,startup,credits,branching", "why": "The biggest database credit gated on team size and stage rather than on a funding round size — a 19-person Series A qualifies", "expires": null, "rating": 8.1, "requiresProgram": "startup", "offer_type": "credits", "value": {"headline": "Up to $30,000 Postgres Branching Credits", "usd": 30000.0, "unit": "usd"}, "eligibility": {"audience": ["startup"], "stage_max": "series_a", "company_age_max_years": 3, "employees_max": 20, "geo_allow": ["global"]}, "terms": {"expiry_days": 365, "activation_window_days": null, "stackable": false, "post_credit_billing": "Standard Guepard platform rates apply once the credits run out.", "renewable": false}, "gates": {"card": null, "phone": null, "kyc": null, "oauth": null, "captcha": null, "ease_score": 50}, "verification": {"verified_at": "2026-11-24", "source_url": "https://guepard.run/startups", "verified_by": "editorial"}, "claim": {"url": "https://guepard.run/startups", "method": "form"}, "status": "active", "disclosure": "editorial"}
{"id": "planetscale-for-startups", "name": "PlanetScale for Startups", "category": "Database", "pricing": "paid", "deal": "Startup Pricing That Cuts the Bill, Not a Balance", "code": "", "url": "https://planetscale.com/startups", "affiliate_url": "", "tracking_id": "planetscale-for-startups", "has_affiliate": false, "desc": "A startup program that works by cutting the invoice rather than handing over an expiring credit balance, and no credit amount is published. Single-node Postgres databases start at $5/mo and high-availability Postgres clusters at $15/mo, and PlanetScale publishes a customer case where a production workload dropped from $900/mo to $90/mo.", "tags": "database,postgres,startup,discount,serverless", "why": "The saving shows up on the invoice instead of a balance that expires — and there is nothing to spend down before the clock runs out", "expires": null, "rating": 8.0, "requiresProgram": "startup", "offer_type": "discount", "value": {"headline": "Startup Pricing That Cuts the Bill, Not a Balance", "usd": null, "unit": null}, "eligibility": {"audience": ["startup"], "geo_allow": ["global"]}, "gates": {"card": null, "phone": null, "kyc": null, "oauth": null, "captcha": null, "ease_score": 45}, "verification": {"verified_at": "2026-11-24", "source_url": "https://planetscale.com/startups", "verified_by": "editorial"}, "claim": {"url": "https://planetscale.com/startups", "method": "form"}, "status": "active", "disclosure": "editorial"}
{"id": "turbopuffer-startup-credits", "name": "Turbopuffer for Startups", "category": "Database", "pricing": "free", "deal": "$8,192 Vector DB Credits", "code": "", "url": "https://turbopuffer.com/startups", "affiliate_url": "", "tracking_id": "turbopuffer-startup-credits", "has_affiliate": false, "desc": "$8,192 in vector database credits for startups under 50 employees and under $50M raised, or $2,048 plus a dedicated Slack channel for scaleups past either line. One set of credits per company, applied for through a single partner, valid for twelve months, and existing customers qualify for the full amount.", "tags": "vector,vector-db,ai,startup,credits,partner-code", "why": "The only vector database that publishes a fixed credit amount instead of a vague discount — you know the number before you apply", "expires": null, "rating": 8.2, "requiresProgram": "startup", "offer_type": "credits", "value": {"headline": "$8,192 Vector DB Credits", "usd": 8192.0, "unit": "usd"}, "eligibility": {"audience": ["startup", "scaleup"], "funding_max_usd": 50000000, "employees_max": 50, "partner_code_required": true, "geo_allow": ["global"]}, "terms": {"expiry_days": 365, "activation_window_days": null, "stackable": false, "post_credit_billing": "Standard turbopuffer usage rates apply once the credits are spent.", "renewable": false}, "gates": {"card": null, "phone": null, "kyc": null, "oauth": null, "captcha": null, "ease_score": 50}, "verification": {"verified_at": "2026-11-24", "source_url": "https://turbopuffer.com/startups", "verified_by": "editorial"}, "claim": {"url": "https://turbopuffer.com/startups", "method": "form"}, "status": "active", "disclosure": "editorial"}
{"id": "read-the-docs-community", "name": "Read the Docs Community", "category": "Open Source Programs", "pricing": "free", "deal": "Free Documentation Hosting for Open Source", "code": "", "url": "https://about.readthedocs.com/pricing/", "affiliate_url": "", "tracking_id": "read-the-docs-community", "has_affiliate": false, "desc": "Always-free documentation hosting for open source and community projects, funded by advertising on the hosted pages. Paid Business plans start at $50/mo, Advanced at $150, Pro at $250, and Enterprise from $10,000/yr once a project outgrows the community tier — so the upgrade path is published rather than discovered at renewal.", "tags": "docs,documentation,open-source,free,static-site", "why": "The default documentation host for open source, and it stays free for exactly the projects that need it", "expires": null, "rating": 8.3, "offer_type": "free_plan", "value": {"headline": "Free Documentation Hosting for Open Source", "usd": null, "unit": null}, "eligibility": {"audience": ["oss"], "geo_allow": ["global"]}, "gates": {"card": null, "phone": null, "kyc": null, "oauth": null, "captcha": null, "ease_score": 20}, "verification": {"verified_at": "2026-11-24", "source_url": "https://about.readthedocs.com/pricing/", "verified_by": "editorial"}, "claim": {"url": "https://about.readthedocs.com/pricing/", "method": "link"}, "status": "active", "disclosure": "editorial"}
{"id": "signpath-foundation", "name": "SignPath Foundation", "category": "Open Source Programs", "pricing": "free", "deal": "Free Code Signing for Open Source", "code": "", "url": "https://signpath.org/", "affiliate_url": "", "tracking_id": "signpath-foundation", "has_affiliate": false, "desc": "Free code-signing certificates and signing service for qualifying open source projects. SignPath verifies that a binary was built from your repository and vouches for it under their own name, which removes the \"unknown publisher\" warning from Windows builds. Projects are required to display attribution on their site.", "tags": "open-source,security,code-signing,free,signing", "why": "Code signing normally costs $200-$500 a year, and almost no project knows the open source route exists", "expires": null, "rating": 8.4, "offer_type": "free_plan", "value": {"headline": "Free Code Signing for Open Source", "usd": null, "unit": null}, "eligibility": {"audience": ["oss"], "referral_required": false, "geo_allow": ["global"]}, "gates": {"card": null, "phone": null, "kyc": null, "oauth": null, "captcha": null, "ease_score": 40}, "verification": {"verified_at": "2026-11-24", "source_url": "https://signpath.org/", "verified_by": "editorial"}, "claim": {"url": "https://signpath.org/", "method": "form"}, "status": "active", "disclosure": "editorial"}
