{"id": "windmill", "name": "Windmill", "category": "Self-Hosted Tools", "pricing": "free", "deal": "Free Self-Hosted (Open Source)", "code": "Automatic (Link)", "url": "https://www.windmill.dev/", "affiliate_url": "", "tracking_id": "windmill", "has_affiliate": false, "desc": "Turn scripts into workflows, internal apps, and scheduled jobs. The open-source edition is free to self-host with unlimited workers, and it handles retries and approval steps.", "tags": "self-hosted,automation,workflows,scripts,open-source", "why": "Script-to-workflow automation with no per-run pricing when self-hosted", "expires": null, "rating": 7.5, "offer_type": "free_plan", "value": {"headline": "Free Self-Hosted (Open Source)", "usd": null, "unit": null}, "eligibility": {"audience": ["oss"]}, "gates": {"card": null, "phone": null, "kyc": null, "oauth": null, "captcha": null, "ease_score": null}, "claim": {"url": "https://www.windmill.dev/", "method": "link"}, "status": "active", "disclosure": "editorial"}
